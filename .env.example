# Local development (docker/local postgres) — a single direct connection is fine:
DATABASE_URL="postgresql://user:password@localhost:5432/listify"
DIRECT_URL="postgresql://user:password@localhost:5432/listify"

# Production (e.g. Supabase): from the project dashboard's "Connect" button,
# ORMs tab -> Prisma. DATABASE_URL is the transaction-mode pooler (port 6543,
# used by the app at runtime). DIRECT_URL is the session-mode/direct
# connection (port 5432, used only by `prisma migrate deploy`) — the pooler
# doesn't support the advisory locks Migrate needs.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres"

# If the password itself contains special characters (@, %, /, :, etc.), it
# must be percent-encoded (e.g. "@" -> "%40") or the URL will fail to parse.

# Admin auth (Google sign-in). Only this exact email may manage schedules —
# anyone else who signs in sees an "access denied" screen. Participant share
# links (/s/[token]) never require sign-in.
ADMIN_EMAIL="you@example.com"

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 33
AUTH_SECRET="generate-your-own"

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Authorized redirect URI must be
# exactly: <your-deployed-url>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev).
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"
